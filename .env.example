# AutoGen Web Tester - Environment Configuration
# Copy this file to .env and fill in your values

# ========== REQUIRED SETTINGS ==========

# OpenAI API Key (required for AI-driven test generation)
OPENAI_API_KEY=your-api-key-here

# Flask Secret Key (required for session security)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-generate-a-random-one

# ========== DATABASE CONFIGURATION ==========

# Database URL
# For local development (SQLite):
DATABASE_URL=sqlite:///user_data/autogen_tester.db

# For production with PostgreSQL (Cloud SQL, RDS, etc.):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# For Cloud SQL on Google Cloud Run:
# DATABASE_URL=postgresql://user:pass@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE

# ========== STORAGE CONFIGURATION ==========

# Base path for user data (workspaces, tests, artifacts)
USER_DATA_PATH=user_data

# ========== SECURITY SETTINGS ==========

# Session cookie security (set to true in production with HTTPS)
SESSION_COOKIE_SECURE=false

# Session lifetime in seconds (default: 7 days)
PERMANENT_SESSION_LIFETIME=604800

# Enable rate limiting (recommended for production)
RATELIMIT_ENABLED=false

# Rate limit storage (use redis:// in production)
RATELIMIT_STORAGE_URL=memory://

# ========== BROWSER SETTINGS ==========

# Website URL for testing
WEBSITE_URL=https://sunny.com

# Run browser in headless mode (no UI)
HEADLESS_MODE=false

# Default timeout for browser operations (milliseconds)
TIMEOUT=60000

# ========== RECORDING SETTINGS ==========

# Enable video recording of test runs
ENABLE_VIDEO_RECORDING=true

# Video recording dimensions
VIDEO_SIZE_WIDTH=1280
VIDEO_SIZE_HEIGHT=720

# Number of videos to keep per test (older ones are deleted)
KEEP_LAST_N_VIDEOS=10

# Enable HAR (HTTP Archive) recording
ENABLE_HAR_RECORDING=true

# Enable trace recording (for debugging, creates large files)
ENABLE_TRACE_RECORDING=false

# Maximum artifact size in MB (fail if exceeded)
MAX_ARTIFACT_SIZE_MB=500

# ========== DATABASE SETTINGS (OPTIONAL) ==========

# Enable SQL query logging (useful for debugging)
SQLALCHEMY_ECHO=false

# ========== DEPLOYMENT SETTINGS ==========

# Port for web server (Cloud Run sets this automatically)
PORT=8080

# Cloud Run service indicator (automatically set by Cloud Run)
# K_SERVICE=your-service-name
